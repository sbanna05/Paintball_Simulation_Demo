# ===============================================
# 1. SORTÖRÉS NORMALIZÁLÁS (Line Ending Normalization)
# ===============================================
# A sortörések automatikus kezelése (LF - Linux/macOS, CRLF - Windows)
# Ezt érdemes a projekt összes fájljára beállítani, különösen a szöveges fájlokra.
* text=auto

# Kikötések a Unity bináris fájlokra: A bináris fájlokat soha ne kezelje szövegként.
# Ezek már tartalmazzák a sortöréseket is (ami a Unity YAML formátuma miatt fontos).
*.meta binary
*.unity binary
*.asset binary
*.prefab binary
*.mat binary
*.vfx binary
*.controller binary
*.anim binary
*.physicMaterial2D binary
*.spriteatlas binary


# ===============================================
# 2. GIT LFS (Large File Storage) BEÁLLÍTÁSOK
# ===============================================
# A nagy, bináris Asset-fájlok tárolása LFS-ben, nem a fő repository-ban.

# 3D modellek, Audio, Videó
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# Textúrák (a VFX és festékfolt textúrák is ide tartoznak)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# Egyéb bináris/nagy fájlok (például a VFX Assetek)
*.vfx filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text
